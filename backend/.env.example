# Use the PostgreSQL URL when running docker compose. SQLite is used by default for easy local development.
# DATABASE_URL=postgresql+psycopg://dealership:dealership_local_password@localhost:5432/dealership
DATABASE_URL=sqlite:///./dealership.db
JWT_SECRET=replace-this-with-a-long-random-secret-before-deployment
JWT_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
